{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackdues",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "account_id": "37dcf91b09d88c94354b136b5a366235",
  "routes": [
    {
      "pattern": "dues.armaldio.xyz",
      "custom_domain": true
    }
  ]
}
