{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackdues",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 */6 * * *"] },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "account_id": "37dcf91b09d88c94354b136b5a366235",
  "routes": [
    {
      "pattern": "dues.armaldio.xyz",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stackdues",
      "database_id": "7497599e-e134-4485-b364-0280187766f6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "quentin.goinaud@gmail.com"
  },
  "ratelimits": [
    {
      "name": "COST_REFRESH_RATE_LIMIT",
      "namespace_id": "2026100802",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "2026100801",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
